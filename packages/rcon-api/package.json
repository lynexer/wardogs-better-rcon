{
    "name": "@lynexer/wardogs-api",
    "version": "0.1.0",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "files": ["dist"],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./schemas": {
            "types": "./dist/schemas.d.ts",
            "import": "./dist/schemas.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "lint": "biome check --write ."
    },
    "peerDependencies": {
        "zod": "^3.23.0 || ^4.0.0"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@repo/biome-config": "workspace:*",
        "@repo/typescript-config": "workspace:*",
        "@types/node": "^22.20.1",
        "typescript": "catalog:",
        "zod": "catalog:"
    },
    "engines": {
        "node": ">=20"
    },
    "publishConfig": {
        "access": "public"
    },
    "keywords": ["wardogs", "rcon", "game-server", "admin"]
}
